      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const update = $input.first().json;\nconst callback = update.callback_query || null;\nconst message = callback?.message || update.message || {};\nconst chat = message.chat || {};\nconst from = callback?.from || message.from || {};\nconst text = callback?.data || message.text || message.caption || '';\nconst document = message.document || null;\nconst photos = message.photo || [];\nconst voice = message.voice || null;\nconst attachments = [];\nif (document) {\n  attachments.push({ type: 'document', file_id: document.file_id, file_name: document.file_name, mime_type: document.mime_type, file_size: document.file_size });\n}\nif (Array.isArray(photos) && photos.length > 0) {\n  const photo = photos[photos.length - 1];\n  attachments.push({ type: 'photo', file_id: photo.file_id, file_size: photo.file_size });\n}\nif (voice) {\n  attachments.push({ type: 'voice', file_id: voice.file_id, mime_type: voice.mime_type, duration: voice.duration, file_size: voice.file_size });\n}\nconst actionMap = {\n  'Пакетна обробка': 'batch_processing_menu',\n  'Додати фото або документ': 'add_material',\n  'Додати голосове повідомлення': 'add_voice',\n  'Показати додані матеріали': 'list_materials',\n  'Видалити матеріал': 'remove_material',\n  'Очистити пакет': 'clear_package',\n  'Почати обробку': 'start_processing',\n  'Статус обробки': 'processing_status',\n  'Скасувати обробку': 'cancel_processing',\n  'Змінити системний промпт': 'edit_profile_prompt',\n  'Клієнти': 'client_menu',\n  'Назад': 'main_menu',\n  'Новий клієнт': 'create_client_profile',\n  'Створити профіль клієнта': 'create_client_profile',\n  'Обрати клієнта': 'select_client_profile',\n  'Показати активного клієнта': 'show_active_client_profile',\n  'Налаштування клієнта': 'edit_client_profile',\n  'Змінити профіль клієнта': 'edit_client_profile',\n  'Видалити клієнта': 'delete_client_profile'\n};\nconst action = actionMap[text] || (attachments.length > 0 ? 'add_material' : 'free_text');\nreturn [{\n  json: {\n    telegram_update_id: update.update_id,\n    chat_id: String(chat.id || ''),\n    telegram_user_id: String(from.id || ''),\n    username: from.username || null,\n    message_id: message.message_id || null,\n    text,\n    action,\n    attachments,\n    has_attachments: attachments.length > 0,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
