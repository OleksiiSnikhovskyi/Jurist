APP_NAME="Ukrainian Legal AI Assistant"
APP_ENV=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=jur_db
POSTGRES_USER=jur_user
POSTGRES_PASSWORD=jur_password
DATABASE_URL=postgresql+psycopg://jur_user:jur_password@localhost:5433/jur_db
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
UPLOAD_DIR=uploads
JUR_API_BASE_URL=http://localhost:8000
JUR_N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
JUR_KB_USER_ID=00000000-0000-0000-0000-000000000001
JUR_KB_USER_EMAIL=jurist@example.local
JUR_KB_USER_NAME="JUR Knowledge Curator"
JUR_KB_WORKSPACE_ID=00000000-0000-0000-0000-000000000101
JUR_KB_WORKSPACE_NAME="JUR Knowledge Base"
JUR_OLLAMA_BASE_URL=http://100.100.209.24:11434
JUR_OLLAMA_MODEL=qwen3:8b
JUR_OLLAMA_TIMEOUT_SECONDS=900
JUR_OLLAMA_THINK=false
JUR_OLLAMA_NUM_CTX=16384
JUR_OLLAMA_NUM_PREDICT=3072
# OpenAI fallback for answer generation when Miledy/Ollama is unavailable.
JUR_OPENAI_API_KEY=
OPENAI_API_KEY=
JUR_OPENAI_FALLBACK_ENABLED=true
JUR_OPENAI_FALLBACK_BASE_URL=https://api.openai.com/v1
JUR_OPENAI_FALLBACK_MODEL=gpt-4o-mini
JUR_OPENAI_FALLBACK_TIMEOUT_SECONDS=120
JUR_OPENAI_FALLBACK_MAX_TOKENS=3072
JUR_RADA_SYNC_LIMIT=3
JUR_RADA_FETCH_RELAY_URL=
JUR_RADA_FETCH_RELAY_TOKEN=
JUR_RADA_FETCH_RELAY_PORT=8031
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://100.100.209.24:11434
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSIONS=1024
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# Controlled evaluation smoke tests. Fill these in a local .env file before live runs.
JUR_SMOKE_API_BASE_URL=http://localhost:8000
JUR_SMOKE_API_KEY=
JUR_SMOKE_TELEGRAM_CHAT_ID=
JUR_SMOKE_TELEGRAM_USER_ID=
JUR_SMOKE_TELEGRAM_USERNAME=jurist_eval_smoke
JUR_SMOKE_WORKSPACE_ID=00000000-0000-0000-0000-000000000101
JUR_SMOKE_USER_ID=00000000-0000-0000-0000-000000000001
JUR_SMOKE_REQUESTED_AGENT=orchestrator
JUR_SMOKE_TIMEOUT_SECONDS=120
JUR_SMOKE_TELEGRAM_BOT_TOKEN=
JUR_SMOKE_TELEGRAM_NOTIFY_CHAT_ID=
